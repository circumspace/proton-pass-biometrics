diff -r a/applications/pass-desktop/src/lib/biometrics/biometrics.linux.ts b/applications/pass-desktop/src/lib/biometrics/biometrics.linux.ts
--- a/applications/pass-desktop/src/lib/biometrics/biometrics.linux.ts	1970-01-01 01:00:00.000000000 +0100
+++ b/applications/pass-desktop/src/lib/biometrics/biometrics.linux.ts	2026-10-07 20:53:38.173540399 +0200
@@ -0,0 +1,35 @@
+import { uint8ArrayToBinaryString } from '@proton/shared/lib/helpers/encoding';
+
+import { biometric as linuxBiometrics } from 'proton-pass-desktop-native';
+
+import type { BiometricsFactory, BiometricsPlatformHandler } from './types';
+
+const factory: BiometricsFactory = (getWindow) => {
+    /** The native backend ignores the window handle on linux: the polkit
+     * authentication agent owns its own prompt window. Pass it through anyway. */
+    const checkPresence = async (reason = 'Proton Pass wants to unlock') => {
+        const handle = getWindow()?.getNativeWindowHandle();
+        await linuxBiometrics.checkPresence(handle ?? Buffer.alloc(0), reason);
+    };
+
+    const biometrics: BiometricsPlatformHandler = {
+        canCheckPresence: () => linuxBiometrics.canCheckPresence().catch(() => false),
+        checkPresence: (reason) => checkPresence(reason),
+        getSecret: async (key, _version) => {
+            await checkPresence();
+
+            const secretBytes = (await linuxBiometrics.getSecret(key)) as Uint8Array<ArrayBuffer>;
+            if (!secretBytes) return null;
+
+            /* Linux never shipped the version 1 legacy format: secrets are
+             * stored as raw byte arrays without any string conversion. */
+            return uint8ArrayToBinaryString(secretBytes);
+        },
+        setSecret: (key, secret) => linuxBiometrics.setSecret(key, secret),
+        deleteSecret: (key) => linuxBiometrics.deleteSecret(key),
+    };
+
+    return biometrics;
+};
+
+export default factory;
