+fn secret_attributes(key: &str) -> HashMap<&str, &str> {
+    HashMap::from([(SECRET_ATTR, key)])
+}
+
+fn open_secret_session(conn: &Connection) -> Result<OwnedObjectPath> {
+    let service = Proxy::new(conn, SECRETS_BUS, SECRETS_SERVICE_PATH, SECRETS_SERVICE_IFACE)?;
+    let (_output, session): (OwnedValue, OwnedObjectPath) =
+        service.call("OpenSession", &("plain", Value::from("")))?;
+    Ok(session)
+}
+
+fn search_secret_items(conn: &Connection, key: &str) -> Result<Vec<OwnedObjectPath>> {
+    let service = Proxy::new(conn, SECRETS_BUS, SECRETS_SERVICE_PATH, SECRETS_SERVICE_IFACE)?;
+    let (unlocked, _locked): (Vec<OwnedObjectPath>, Vec<OwnedObjectPath>) =
+        service.call("SearchItems", &secret_attributes(key))?;
+    Ok(unlocked)
+}
+
+fn pkcheck_available() -> bool {
+    std::env::var_os("PATH")
+        .map(|paths| std::env::split_paths(&paths).any(|dir| dir.join("pkcheck").is_file()))
+        .unwrap_or(false)
