+fn can_check_presence_blocking() -> Result<bool> {
+    // The lock settings only offer the biometrics option while this
+    // returns true, so any failure here is reported as "unavailable"
+    // rather than surfaced as an error.
+    let probe = || -> Result<bool> {
+        if !pkcheck_available() {
+            return Ok(false);
+        }
+
+        let user = whoami::username();
+        let conn = Connection::system()?;
+        let manager = Proxy::new(&conn, FPRINT_BUS, FPRINT_MANAGER_PATH, FPRINT_MANAGER_IFACE)?;
+        let devices: Vec<OwnedObjectPath> = manager.call("GetDevices", &())?;
+
+        Ok(devices.iter().any(|device| {
+            let Ok(device) = Proxy::new(&conn, FPRINT_BUS, device.as_str(), FPRINT_DEVICE_IFACE) else {
+                return false;
+            };
+            let fingers: Vec<String> = device.call("ListEnrolledFingers", &user).unwrap_or_default();
+            !fingers.is_empty()
+        }))
+    };
+
+    Ok(probe().unwrap_or_else(|err| {
+        log::warn!("[biometrics] presence check failed: {err}");
+        false
+    }))
+}
