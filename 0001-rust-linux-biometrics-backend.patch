+// The napi layer exposes these trait methods as async functions, so they run
+// on its tokio runtime. zbus' blocking API drives its own executor and panics
+// when nested inside one, so every call runs on a plain OS thread.
+fn run<T, F>(f: F) -> Result<T>
+where
+    T: Send + 'static,
+    F: FnOnce() -> Result<T> + Send + 'static,
+{
+    std::thread::scope(|scope| {
+        scope
+            .spawn(f)
+            .join()
+            .map_err(|_| anyhow!("biometrics worker thread panicked"))?
+    })
+}
