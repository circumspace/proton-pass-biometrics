+fn run_prompt(conn: &Connection, prompt: OwnedObjectPath) -> Result<()> {
+    let prompt_proxy = Proxy::new(conn, SECRETS_BUS, prompt.as_str(), SECRETS_PROMPT_IFACE)?;
+    let mut completed = prompt_proxy.receive_signal("Completed")?;
+    let _: () = prompt_proxy.call("Prompt", &"")?;
+
+    let message = completed.next().ok_or_else(|| anyhow!("prompt closed without completing"))?;
+    let (dismissed, _result): (bool, OwnedValue) = message.body().deserialize()?;
+
+    if dismissed {
+        bail!("Keyring unlock prompt was cancelled");
     }
+
+    Ok(())
 }
